---
import BookCard from '@/components/book/BookCard.astro';
import AppShell from '@/components/layout/AppShell.astro';
import TopBar from '@/components/layout/TopBar.astro';
import LucideIcon from '@/components/ui/LucideIcon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBooks } from '@/lib/queries/books';

const books = await getBooks();

const preferredBookOrder = [
  'designing-interfaces',
  'every-layout',
  'web-accessibility',
  'refactoring-ui',
  'learning-react',
  'practical-react-nextjs',
];

const orderedBooks = [...books].sort((bookA, bookB) => {
  const indexA = preferredBookOrder.indexOf(bookA.slug);
  const indexB = preferredBookOrder.indexOf(bookB.slug);

  return (indexA === -1 ? Number.MAX_SAFE_INTEGER : indexA) - (indexB === -1 ? Number.MAX_SAFE_INTEGER : indexB);
});

const statusFilters = [
  { label: '読了', value: 'read' },
  { label: '読書中', value: 'reading' },
  { label: '積読', value: 'unread' },
  { label: '未分類', value: 'unclassified' },
];

const difficultyFilters = [
  { label: '入門', value: 'intro' },
  { label: '中級', value: 'intermediate' },
  { label: '上級', value: 'advanced' },
];

const ownershipFilters = [
  { label: '電子書籍', value: 'digital' },
  { label: '紙', value: 'physical' },
  { label: '両方', value: 'mixed' },
];

const signalFilters = [
  { label: '高', value: 'high' },
  { label: '中', value: 'medium' },
  { label: '低', value: 'low' },
];

const getDifficultyBand = (value?: number) => {
  if (!value) {
    return '';
  }

  if (value <= 2) {
    return 'intro';
  }

  return value === 3 ? 'intermediate' : 'advanced';
};

const getSignalBand = (value?: number) => {
  if (!value) {
    return '';
  }

  if (value <= 2) {
    return 'low';
  }

  return value === 3 ? 'medium' : 'high';
};

const getOwnershipBand = (value?: string) => {
  if (!value) {
    return '';
  }

  return ['kindle', 'pdf', 'web'].includes(value) ? 'digital' : 'physical';
};
---

<BaseLayout title="ライブラリ" description="技術書を知識ノードとして探索するライブラリ。">
  <AppShell currentPath={Astro.url.pathname} showTopBar={false}>
    <div class="library-page" data-library-page>
      <section class="library-workbench" aria-labelledby="library-title">
        <TopBar />

        <div class="library-toolbar">
          <div class="library-toolbar__left">
            <div class="library-toolbar__title-stack">
              <h1 id="library-title" class="library-toolbar__title">ライブラリ</h1>
              <p class="library-toolbar__count" data-library-count>{orderedBooks.length}冊</p>
            </div>

            <button
              class="library-filter-summary-toggle"
              type="button"
              aria-expanded="false"
              aria-controls="library-filter-panel"
              aria-label="フィルターを開く"
              data-library-filter-toggle
            >
              <LucideIcon name="SlidersHorizontal" size={16} strokeWidth={1.75} aria-hidden="true" />
              <span>フィルター</span>
              <span class="library-filter-summary-toggle__count" data-active-filter-count hidden>0</span>
            </button>
          </div>

          <div class="library-view-switcher" aria-label="表示モード">
            <button class="library-view-switcher__button is-active" type="button" aria-pressed="true" aria-label="グリッド表示" data-library-view="grid">
              <LucideIcon name="LayoutGrid" size={16} strokeWidth={1.75} aria-hidden="true" />
            </button>
            <button class="library-view-switcher__button" type="button" aria-pressed="false" aria-label="リスト表示" data-library-view="list">
              <LucideIcon name="List" size={16} strokeWidth={1.75} aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="library-active-filters" data-active-filters hidden>
          <span class="library-active-filters__label">絞り込み中:</span>
          <div class="library-active-filters__chips" data-active-filter-chips></div>
          <button class="library-active-filters__clear" type="button" data-clear-filters>すべてクリア</button>
        </div>

        <form
          id="library-filter-panel"
          class="library-instrument-strip"
          aria-labelledby="library-filter-strip-title"
          data-library-filter-panel
          hidden
        >
          <div class="library-instrument-strip__header">
            <h2 id="library-filter-strip-title" class="library-instrument-strip__title">FILTERS</h2>
            <button class="library-instrument-strip__close" type="button" data-library-filter-close>× 閉じる</button>
          </div>

          <div class="library-instrument-strip__segments">
            <fieldset class="library-instrument-segment">
              <legend>読書状態</legend>
              <div class="library-filter-pills">
                {
                  statusFilters.map((filter) => (
                    <label class="library-filter-pill">
                      <input class="sr-only" type="checkbox" name="status" value={filter.value} data-filter-label={filter.label} data-library-filter />
                      <span>{filter.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="library-instrument-segment">
              <legend>難易度</legend>
              <div class="library-filter-pills">
                {
                  difficultyFilters.map((filter) => (
                    <label class="library-filter-pill">
                      <input class="sr-only" type="checkbox" name="difficulty" value={filter.value} data-filter-label={`難易度：${filter.label}`} data-library-filter />
                      <span>{filter.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="library-instrument-segment">
              <legend>所有形式</legend>
              <div class="library-filter-pills">
                {
                  ownershipFilters.map((filter) => (
                    <label class="library-filter-pill">
                      <input class="sr-only" type="checkbox" name="ownership" value={filter.value} data-filter-label={filter.label} data-library-filter />
                      <span>{filter.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="library-instrument-segment">
              <legend>実務適用度</legend>
              <div class="library-filter-pills">
                {
                  signalFilters.map((filter) => (
                    <label class="library-filter-pill">
                      <input class="sr-only" type="checkbox" name="practicality" value={filter.value} data-filter-label={`実務適用度：${filter.label}`} data-library-filter />
                      <span>{filter.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>

            <fieldset class="library-instrument-segment">
              <legend>再読価値</legend>
              <div class="library-filter-pills">
                {
                  signalFilters.map((filter) => (
                    <label class="library-filter-pill">
                      <input class="sr-only" type="checkbox" name="reread" value={filter.value} data-filter-label={`再読価値：${filter.label}`} data-library-filter />
                      <span>{filter.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </div>
        </form>

        <div class="library-grid" aria-label="技術書一覧" data-library-grid data-view="grid">
          {
            orderedBooks.map((book) => (
              <div
                class="library-grid__item"
                data-library-card
                data-status={book.status}
                data-difficulty={getDifficultyBand(book.difficulty)}
                data-ownership={getOwnershipBand(book.ownership)}
                data-practicality={getSignalBand(book.practicality)}
                data-reread={getSignalBand(book.rereadValue)}
              >
                <BookCard book={book} variant="specimen" showTopics />
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </AppShell>
</BaseLayout>

<script>
  const libraryPage = document.querySelector<HTMLElement>('[data-library-page]');

  if (libraryPage) {
    const filterInputs = Array.from(libraryPage.querySelectorAll<HTMLInputElement>('[data-library-filter]'));
    const cards = Array.from(libraryPage.querySelectorAll<HTMLElement>('[data-library-card]'));
    const count = libraryPage.querySelector<HTMLElement>('[data-library-count]');
    const grid = libraryPage.querySelector<HTMLElement>('[data-library-grid]');
    const filterPanel = libraryPage.querySelector<HTMLElement>('[data-library-filter-panel]');
    const filterToggles = Array.from(libraryPage.querySelectorAll<HTMLButtonElement>('[data-library-filter-toggle]'));
    const filterClose = libraryPage.querySelector<HTMLButtonElement>('[data-library-filter-close]');
    const activeFilterCount = libraryPage.querySelector<HTMLElement>('[data-active-filter-count]');
    const activeFilters = libraryPage.querySelector<HTMLElement>('[data-active-filters]');
    const activeFilterChips = libraryPage.querySelector<HTMLElement>('[data-active-filter-chips]');
    const clearFilters = libraryPage.querySelector<HTMLButtonElement>('[data-clear-filters]');
    const viewButtons = Array.from(libraryPage.querySelectorAll<HTMLButtonElement>('[data-library-view]'));

    const getCheckedValues = (name: string) =>
      new Set(filterInputs.filter((input) => input.name === name && input.checked).map((input) => input.value));

    const matchesFilter = (selectedValues: Set<string>, value: string | undefined) =>
      selectedValues.size === 0 || (value !== undefined && selectedValues.has(value));

    const setFiltersExpanded = (isExpanded: boolean) => {
      libraryPage.dataset.filters = isExpanded ? 'expanded' : 'collapsed';

      if (filterPanel) {
        filterPanel.hidden = !isExpanded;
      }

      filterToggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(isExpanded));
        toggle.setAttribute('aria-label', isExpanded ? 'フィルターを閉じる' : 'フィルターを開く');
      });

      updateActiveFilters();
    };

    const getActiveFilterInputs = () => filterInputs.filter((input) => input.checked);

    const updateActiveFilters = () => {
      const activeInputs = getActiveFilterInputs();
      const isCollapsed = libraryPage.dataset.filters === 'collapsed';

      if (activeFilterCount) {
        activeFilterCount.textContent = String(activeInputs.length);
        activeFilterCount.hidden = activeInputs.length === 0;
      }

      if (activeFilterChips) {
        activeFilterChips.replaceChildren();

        activeInputs.forEach((input) => {
          const chip = document.createElement('button');
          const label = input.dataset.filterLabel ?? input.value;

          chip.className = 'library-active-filter-chip';
          chip.type = 'button';
          chip.dataset.filterName = input.name;
          chip.dataset.filterValue = input.value;
          chip.setAttribute('aria-label', `${label} の条件を解除`);
          chip.textContent = `${label} ×`;
          activeFilterChips.append(chip);
        });
      }

      if (activeFilters) {
        activeFilters.hidden = !isCollapsed || activeInputs.length === 0;
      }
    };

    const updateFilters = () => {
      const selectedStatuses = getCheckedValues('status');
      const selectedDifficulties = getCheckedValues('difficulty');
      const selectedOwnerships = getCheckedValues('ownership');
      const selectedPracticalities = getCheckedValues('practicality');
      const selectedRereadValues = getCheckedValues('reread');
      let visibleCount = 0;

      cards.forEach((card) => {
        const statusMatches = selectedStatuses.size === 0 || selectedStatuses.has(card.dataset.status ?? '');
        const ownershipMatches =
          selectedOwnerships.size === 0 ||
          selectedOwnerships.has(card.dataset.ownership ?? '') ||
          (selectedOwnerships.has('mixed') && Boolean(card.dataset.ownership));
        const isVisible =
          statusMatches &&
          matchesFilter(selectedDifficulties, card.dataset.difficulty) &&
          ownershipMatches &&
          matchesFilter(selectedPracticalities, card.dataset.practicality) &&
          matchesFilter(selectedRereadValues, card.dataset.reread);

        card.hidden = !isVisible;
        visibleCount += isVisible ? 1 : 0;
      });

      if (count) {
        count.textContent = `${visibleCount}冊`;
      }

      updateActiveFilters();
    };

    const setView = (view: string) => {
      if (grid) {
        grid.dataset.view = view;
      }

      viewButtons.forEach((button) => {
        const isActive = button.dataset.libraryView === view;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });
    };

    filterInputs.forEach((input) => input.addEventListener('change', updateFilters));
    filterToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => setFiltersExpanded(libraryPage.dataset.filters !== 'expanded'));
    });
    filterClose?.addEventListener('click', () => setFiltersExpanded(false));
    activeFilterChips?.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('.library-active-filter-chip');

      if (!chip) {
        return;
      }

      const targetInput = filterInputs.find(
        (input) => input.name === chip.dataset.filterName && input.value === chip.dataset.filterValue,
      );

      if (targetInput) {
        targetInput.checked = false;
        updateFilters();
      }
    });
    clearFilters?.addEventListener('click', () => {
      filterInputs.forEach((input) => {
        input.checked = false;
      });

      updateFilters();
    });
    viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.libraryView ?? 'grid')));

    setFiltersExpanded(false);
    updateFilters();
  }
</script>

---
import BookCard from '@/components/book/BookCard.astro';
import AppShell from '@/components/layout/AppShell.astro';
import TopBar from '@/components/layout/TopBar.astro';
import LucideIcon from '@/components/ui/LucideIcon.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getBooks } from '@/lib/queries/books';
import { getTopics } from '@/lib/queries/topics';

const [books, topics] = await Promise.all([getBooks(), getTopics()]);

const preferredBookOrder = [
  'designing-interfaces',
  'every-layout',
  'web-accessibility',
  'refactoring-ui',
  'learning-react',
  'practical-react-nextjs',
];

const preferredTopicOrder = [
  'accessibility',
  'css-architecture',
  'design-system',
  'react',
  'typescript',
  'nextjs',
];

const topicFilterLabels: Record<string, string> = {
  accessibility: 'Accessibility',
  'css-architecture': 'CSS設計',
  'design-system': 'Design System',
  react: 'React',
  typescript: 'TypeScript',
  nextjs: 'Next.js',
};

const orderedBooks = [...books].sort((bookA, bookB) => {
  const indexA = preferredBookOrder.indexOf(bookA.slug);
  const indexB = preferredBookOrder.indexOf(bookB.slug);

  return (indexA === -1 ? Number.MAX_SAFE_INTEGER : indexA) - (indexB === -1 ? Number.MAX_SAFE_INTEGER : indexB);
});

const filterTopics = preferredTopicOrder
  .map((slug) => topics.find((topic) => topic.slug === slug))
  .filter((topic) => topic !== undefined);

const statusFilters = [
  { label: '読了', value: 'read' },
  { label: '読書中', value: 'reading' },
  { label: '積読', value: 'unread' },
  { label: '未分類', value: 'unclassified' },
];
---

<BaseLayout title="ライブラリ" description="技術書を知識ノードとして探索するライブラリ。">
  <AppShell currentPath={Astro.url.pathname} showTopBar={false}>
    <div class="library-page" data-library-page>
      <aside class="library-filters" aria-labelledby="library-filter-title">
        <div class="library-filters__header">
          <h2 id="library-filter-title" class="library-filters__title">FILTER</h2>
          <button
            class="library-filters__toggle"
            type="button"
            aria-expanded="true"
            aria-controls="library-filter-panel"
            aria-label="フィルターを畳む"
            data-library-filter-toggle
          >
            <LucideIcon name="PanelLeftClose" size={16} strokeWidth={1.75} class="library-filters__toggle-icon library-filters__toggle-icon--collapse" aria-hidden="true" />
            <LucideIcon name="PanelLeftOpen" size={16} strokeWidth={1.75} class="library-filters__toggle-icon library-filters__toggle-icon--expand" aria-hidden="true" />
          </button>
        </div>

        <form id="library-filter-panel" class="library-filters__form" data-library-filters>
          <fieldset class="library-filter-group">
            <legend>読書状態</legend>
            {
              statusFilters.map((filter) => (
                <label class="library-filter-option">
                  <input type="checkbox" name="status" value={filter.value} data-filter-label={filter.label} data-library-filter />
                  <span>{filter.label}</span>
                </label>
              ))
            }
          </fieldset>

          <fieldset class="library-filter-group">
            <legend>技術トピック</legend>
            {
              filterTopics.map((topic) => (
                <label class="library-filter-option">
                  <input type="checkbox" name="topic" value={topic.slug} data-filter-label={topicFilterLabels[topic.slug] ?? topic.name} data-library-filter />
                  <span>{topicFilterLabels[topic.slug] ?? topic.name}</span>
                </label>
              ))
            }
          </fieldset>
        </form>
      </aside>

      <section class="library-workbench" aria-labelledby="library-title">
        <TopBar />

        <button
          class="library-filter-summary-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="library-filter-panel"
          aria-label="フィルターを開く"
          data-library-filter-toggle
        >
          <LucideIcon name="SlidersHorizontal" size={16} strokeWidth={1.75} aria-hidden="true" />
          <span>フィルター</span>
          <span class="library-filter-summary-toggle__count" data-active-filter-count hidden>0</span>
        </button>

        <div class="library-toolbar">
          <div>
            <h1 id="library-title" class="library-toolbar__title">Library</h1>
            <p class="library-toolbar__count" data-library-count>全{orderedBooks.length}冊</p>
          </div>

          <div class="library-view-switcher" aria-label="表示モード">
            <button class="library-view-switcher__button is-active" type="button" aria-pressed="true" aria-label="グリッド表示" data-library-view="grid">
              <LucideIcon name="LayoutGrid" size={16} strokeWidth={1.75} aria-hidden="true" />
            </button>
            <button class="library-view-switcher__button" type="button" aria-pressed="false" aria-label="リスト表示" data-library-view="list">
              <LucideIcon name="List" size={16} strokeWidth={1.75} aria-hidden="true" />
            </button>
          </div>
        </div>

        <div class="library-active-filters" data-active-filters hidden>
          <span class="library-active-filters__label">絞り込み中:</span>
          <div class="library-active-filters__chips" data-active-filter-chips></div>
          <button class="library-active-filters__clear" type="button" data-clear-filters>すべてクリア</button>
        </div>

        <div class="library-grid" aria-label="技術書一覧" data-library-grid data-view="grid">
          {
            orderedBooks.map((book) => (
              <div
                class="library-grid__item"
                data-library-card
                data-status={book.status}
                data-topics={book.topics?.map((topic) => topic.slug).join(' ') ?? ''}
              >
                <BookCard book={book} variant="specimen" showTopics />
              </div>
            ))
          }
        </div>
      </section>
    </div>
  </AppShell>
</BaseLayout>

<script>
  const libraryPage = document.querySelector<HTMLElement>('[data-library-page]');

  if (libraryPage) {
    const filterInputs = Array.from(libraryPage.querySelectorAll<HTMLInputElement>('[data-library-filter]'));
    const cards = Array.from(libraryPage.querySelectorAll<HTMLElement>('[data-library-card]'));
    const count = libraryPage.querySelector<HTMLElement>('[data-library-count]');
    const grid = libraryPage.querySelector<HTMLElement>('[data-library-grid]');
    const filterPanel = libraryPage.querySelector<HTMLFormElement>('[data-library-filters]');
    const filterToggles = Array.from(libraryPage.querySelectorAll<HTMLButtonElement>('[data-library-filter-toggle]'));
    const activeFilterCount = libraryPage.querySelector<HTMLElement>('[data-active-filter-count]');
    const activeFilters = libraryPage.querySelector<HTMLElement>('[data-active-filters]');
    const activeFilterChips = libraryPage.querySelector<HTMLElement>('[data-active-filter-chips]');
    const clearFilters = libraryPage.querySelector<HTMLButtonElement>('[data-clear-filters]');
    const viewButtons = Array.from(libraryPage.querySelectorAll<HTMLButtonElement>('[data-library-view]'));
    const filterStorageKey = 'stack-library:library-filters';

    const getCheckedValues = (name: string) =>
      new Set(filterInputs.filter((input) => input.name === name && input.checked).map((input) => input.value));

    const setFiltersCollapsed = (isCollapsed: boolean) => {
      libraryPage.dataset.filters = isCollapsed ? 'collapsed' : 'expanded';

      if (filterPanel) {
        filterPanel.hidden = isCollapsed;
      }

      filterToggles.forEach((toggle) => {
        toggle.setAttribute('aria-expanded', String(!isCollapsed));
        toggle.setAttribute('aria-label', isCollapsed ? 'フィルターを開く' : 'フィルターを畳む');
      });

      try {
        window.localStorage.setItem(filterStorageKey, isCollapsed ? 'collapsed' : 'expanded');
      } catch {
        // Storage can be unavailable in restricted browser contexts.
      }

      updateActiveFilters();
    };

    const getActiveFilterInputs = () => filterInputs.filter((input) => input.checked);

    const updateActiveFilters = () => {
      const activeInputs = getActiveFilterInputs();
      const isCollapsed = libraryPage.dataset.filters === 'collapsed';

      if (activeFilterCount) {
        activeFilterCount.textContent = String(activeInputs.length);
        activeFilterCount.hidden = activeInputs.length === 0;
      }

      if (activeFilterChips) {
        activeFilterChips.replaceChildren();

        activeInputs.forEach((input) => {
          const chip = document.createElement('button');
          const label = input.dataset.filterLabel ?? input.value;

          chip.className = 'library-active-filter-chip';
          chip.type = 'button';
          chip.dataset.filterName = input.name;
          chip.dataset.filterValue = input.value;
          chip.setAttribute('aria-label', `${label} の条件を解除`);
          chip.textContent = `${label} ×`;
          activeFilterChips.append(chip);
        });
      }

      if (activeFilters) {
        activeFilters.hidden = !isCollapsed || activeInputs.length === 0;
      }
    };

    const updateFilters = () => {
      const selectedStatuses = getCheckedValues('status');
      const selectedTopics = getCheckedValues('topic');
      let visibleCount = 0;

      cards.forEach((card) => {
        const cardTopics = (card.dataset.topics ?? '').split(' ').filter(Boolean);
        const statusMatches = selectedStatuses.size === 0 || selectedStatuses.has(card.dataset.status ?? '');
        const topicMatches = selectedTopics.size === 0 || cardTopics.some((topic) => selectedTopics.has(topic));
        const isVisible = statusMatches && topicMatches;

        card.hidden = !isVisible;
        visibleCount += isVisible ? 1 : 0;
      });

      if (count) {
        count.textContent = `全${visibleCount}冊`;
      }

      updateActiveFilters();
    };

    const setView = (view: string) => {
      if (grid) {
        grid.dataset.view = view;
      }

      viewButtons.forEach((button) => {
        const isActive = button.dataset.libraryView === view;
        button.classList.toggle('is-active', isActive);
        button.setAttribute('aria-pressed', String(isActive));
      });
    };

    filterInputs.forEach((input) => input.addEventListener('change', updateFilters));
    filterToggles.forEach((toggle) => {
      toggle.addEventListener('click', () => setFiltersCollapsed(libraryPage.dataset.filters !== 'collapsed'));
    });
    activeFilterChips?.addEventListener('click', (event) => {
      const chip = (event.target as HTMLElement).closest<HTMLButtonElement>('.library-active-filter-chip');

      if (!chip) {
        return;
      }

      const targetInput = filterInputs.find(
        (input) => input.name === chip.dataset.filterName && input.value === chip.dataset.filterValue,
      );

      if (targetInput) {
        targetInput.checked = false;
        updateFilters();
      }
    });
    clearFilters?.addEventListener('click', () => {
      filterInputs.forEach((input) => {
        input.checked = false;
      });

      updateFilters();
    });
    viewButtons.forEach((button) => button.addEventListener('click', () => setView(button.dataset.libraryView ?? 'grid')));

    try {
      setFiltersCollapsed(window.localStorage.getItem(filterStorageKey) === 'collapsed');
    } catch {
      setFiltersCollapsed(false);
    }

    updateFilters();
  }
</script>

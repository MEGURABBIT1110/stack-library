---
import BookSignalStats from '@/components/book/BookSignalStats.astro';
import SiteSidebar from '@/components/layout/SiteSidebar.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatAuthors, formatYearMonth } from '@/lib/format';
import { getBookBySlug, getBooks } from '@/lib/queries/books';
import { getNotes } from '@/lib/queries/notes';
import type { SignalValue } from '@/types/content';

export async function getStaticPaths() {
  const books = await getBooks();

  return books.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const slug = Astro.params.slug;
const book = Astro.props.book ?? (slug ? await getBookBySlug(slug) : null);

if (!book) {
  return Astro.redirect('/library/');
}

const [allBooks, allNotes] = await Promise.all([getBooks(), getNotes()]);
const topicSlugs = new Set(book.topics?.map((topic) => topic.slug) ?? []);
const relatedNotes = allNotes.filter((note) => note.book?.slug === book.slug).slice(0, 3);
const relatedBooks = allBooks
  .filter((candidate) => candidate.slug !== book.slug)
  .filter((candidate) => candidate.topics?.some((topic) => topicSlugs.has(topic.slug)))
  .slice(0, 2);

const publisherName = book.publisher?.name ?? '未設定';
const completedLabel = book.readFinishedAt ? `${formatYearMonth(book.readFinishedAt)}完了` : '未完了';
const coverAlt = `「${book.title}」の表紙`;
const readingPurpose = book.readingPurpose?.trim();

const difficultyEnglishLabels: Record<SignalValue, string> = {
  1: 'Introductory',
  2: 'Beginner',
  3: 'Intermediate',
  4: 'Advanced',
  5: 'Expert',
};

const difficultyPanelLabel = book.difficulty
  ? difficultyEnglishLabels[book.difficulty]
  : 'Not set';

const ensureSentence = (text: string) => (
  /[。.!?！？]$/.test(text) ? text : `${text}。`
);
---

<BaseLayout title={book.title} description={book.summary}>
  <main id="main-content" class="book-detail-frame" aria-labelledby="book-title">
    <SiteSidebar currentPath="/library/" />

    <article class="book-detail-frame__book-panel" aria-label="書籍メタデータ">
      <div class="book-detail-frame__cover">
        {
          book.cover ? (
            <img src={book.cover.url} alt={coverAlt} />
          ) : (
            <span class="book-detail-frame__cover-label" aria-hidden="true">{book.title.slice(0, 2)}</span>
          )
        }
      </div>

      <section class="book-detail-frame__meta" aria-labelledby="book-title">
        <header class="book-detail-frame__title-block">
          <h1 id="book-title" class="book-detail-frame__title">{book.title}</h1>
          {book.subtitle && <p class="book-detail-frame__subtitle">{book.subtitle}</p>}
        </header>

        <dl class="book-detail-frame__specimen-labels">
          <div class="book-detail-frame__label-row">
            <dt>AUTHOR</dt>
            <dd>{formatAuthors(book.authors)}</dd>
          </div>
          <div class="book-detail-frame__label-row">
            <dt>PUBLISHER</dt>
            <dd>{publisherName}</dd>
          </div>
          <div class="book-detail-frame__label-row">
            <dt>COMPLETED</dt>
            <dd>{completedLabel}</dd>
          </div>
          <div class="book-detail-frame__label-row">
            <dt>DIFFICULTY</dt>
            <dd>{difficultyPanelLabel}</dd>
          </div>
        </dl>

        {
          book.topics && book.topics.length > 0 && (
            <div class="book-detail-frame__tags" aria-label="関連する技術トピック">
              {book.topics.map((topic) => (
                <a class="book-detail-frame__tag" href={`/topics/${topic.slug}/`}>
                  {`#${topic.slug}`}
                </a>
              ))}
            </div>
          )
        }
      </section>
    </article>

    <section class="book-detail-frame__detail-panel" aria-labelledby="reading-notes-title" tabindex="0">
      <header class="book-detail-frame__notes-header">
        <h2 id="reading-notes-title">READING NOTES</h2>
        <a class="book-detail-frame__map-action" href="/map/" aria-label="知識マップでこの本の接続を見る">
          <span aria-hidden="true"></span>
        </a>
      </header>

      <div class="book-detail-frame__scroll-content">
        <BookSignalStats
          class="book-detail-frame__stats"
          difficulty={book.difficulty}
          practicality={book.practicality}
          rereadValue={book.rereadValue}
          conceptDensity={book.conceptDensity}
        />

        {
          readingPurpose && (
            <section class="book-detail-frame__note-block" aria-label="なぜ読んだか">
              <p class="book-detail-frame__note-label">// why i read this</p>
              <p class="book-detail-frame__note-text">{readingPurpose}</p>
            </section>
          )
        }

        <section class="book-detail-frame__insights" aria-label="重要な気づき">
          {
            relatedNotes.length > 0 ? (
              <div class="book-detail-frame__insight-list">
                {relatedNotes.map((note, index) => (
                  <a
                    class="book-detail-frame__note-block book-detail-frame__note-block--link"
                    href={`/notes/${note.slug}/`}
                    aria-label={`${note.title} の読書メモを開く`}
                  >
                    <span class="book-detail-frame__note-label">
                      {`// insight ${String(index + 1).padStart(2, '0')}`}
                    </span>
                    <span class="book-detail-frame__note-text">{ensureSentence(note.title)}</span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="book-detail-frame__empty-card">この本に紐づく読書メモはまだありません。</p>
            )
          }
        </section>

        <section class="book-detail-frame__related" aria-label="関連する技術書">
          <p class="book-detail-frame__note-label">// related books</p>
          {
            relatedBooks.length > 0 ? (
              <div class="book-detail-frame__related-list">
                {relatedBooks.map((relatedBook) => (
                  <a class="book-detail-frame__related-card" href={`/books/${relatedBook.slug}/`}>
                    <span class="book-detail-frame__related-cover" aria-hidden="true"></span>
                    <span class="book-detail-frame__related-body">
                      <span class="book-detail-frame__related-title">{relatedBook.title}</span>
                      <span class="book-detail-frame__related-author">{formatAuthors(relatedBook.authors)}</span>
                      <span class="book-detail-frame__related-meta">
                        {`// ${relatedBook.topics?.[0]?.slug ?? 'knowledge connection'}`}
                      </span>
                    </span>
                  </a>
                ))}
              </div>
            ) : (
              <p class="book-detail-frame__empty-card">
                関連する技術書はまだ見つかっていません。
              </p>
            )
          }
        </section>
      </div>
    </section>
  </main>
</BaseLayout>

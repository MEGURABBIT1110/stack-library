---
import BookSignalPanel from '@/components/book/BookSignalPanel.astro';
import ReadingStatusBadge from '@/components/book/ReadingStatusBadge.astro';
import AppShell from '@/components/layout/AppShell.astro';
import PageShell from '@/components/layout/PageShell.astro';
import TopicChip from '@/components/topic/TopicChip.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { formatAuthors, formatYearMonth } from '@/lib/format';
import { getBookBySlug, getBooks } from '@/lib/queries/books';
import { getNotes } from '@/lib/queries/notes';
import { OWNERSHIP_LABELS } from '@/types/content';

export async function getStaticPaths() {
  const books = await getBooks();

  return books.map((book) => ({
    params: { slug: book.slug },
    props: { book },
  }));
}

const slug = Astro.params.slug;
const book = Astro.props.book ?? (slug ? await getBookBySlug(slug) : null);

if (!book) {
  return Astro.redirect('/library/');
}

const [allBooks, allNotes] = await Promise.all([getBooks(), getNotes()]);
const topicSlugs = new Set(book.topics?.map((topic) => topic.slug) ?? []);
const relatedNotes = allNotes.filter((note) => note.book?.slug === book.slug).slice(0, 3);
const relatedBooks = allBooks
  .filter((candidate) => candidate.slug !== book.slug)
  .filter((candidate) => candidate.topics?.some((topic) => topicSlugs.has(topic.slug)))
  .slice(0, 2);

const publisherName = book.publisher?.name ?? '未設定';
const formatLabel = book.ownership ? OWNERSHIP_LABELS[book.ownership] : '未設定';
const completedLabel = formatYearMonth(book.readFinishedAt);
const coverAlt = `「${book.title}」の表紙`;
---

<BaseLayout title={book.title} description={book.summary}>
  <AppShell currentPath="/library/">
    <PageShell variant="wide">
      <nav class="breadcrumb" aria-label="パンくず">
        <ol>
          <li><a href="/library/">ライブラリ</a></li>
          <li aria-current="page">{book.title}</li>
        </ol>
      </nav>

      <article class="book-detail" aria-labelledby="book-title">
        <aside class="book-detail__aside" aria-label="書籍メタデータ">
          <div class="book-detail__cover">
            {
              book.cover ? (
                <img src={book.cover.url} alt={coverAlt} />
              ) : (
                <span class="book-detail__cover-label" aria-hidden="true">{book.title.slice(0, 2)}</span>
              )
            }
          </div>

          <div class="book-detail__meta">
            <header>
              <h1 id="book-title" class="book-detail__title">{book.title}</h1>
              {book.subtitle && <p class="book-detail__subtitle">{book.subtitle}</p>}
            </header>

            <dl class="book-detail__definition-list">
              <div>
                <dt>AUTHOR</dt>
                <dd>{formatAuthors(book.authors)}</dd>
              </div>
              <div>
                <dt>PUBLISHER</dt>
                <dd>{publisherName}</dd>
              </div>
              <div>
                <dt>STATUS</dt>
                <dd><ReadingStatusBadge status={book.status} /></dd>
              </div>
              <div>
                <dt>FORMAT</dt>
                <dd>{formatLabel}</dd>
              </div>
              <div>
                <dt>COMPLETED</dt>
                <dd>{completedLabel}</dd>
              </div>
            </dl>

            {
              book.topics && book.topics.length > 0 && (
                <div class="book-detail__topics" aria-label="関連する技術トピック">
                  {book.topics.map((topic) => <TopicChip topic={topic} />)}
                </div>
              )
            }
          </div>
        </aside>

        <div class="book-detail__main">
          <BookSignalPanel
            difficulty={book.difficulty}
            practicality={book.practicality}
            rereadValue={book.rereadValue}
            conceptDensity={book.conceptDensity}
            implementationValue={book.implementationValue}
          />

          <div class="book-detail__sections">
            <section class="book-detail-section" aria-labelledby="reading-purpose-title">
              <h2 id="reading-purpose-title">なぜ読んだか</h2>
              <p>{book.readingPurpose ?? book.summary ?? 'この本を読んだ目的はまだ記録されていません。'}</p>
            </section>

            <section class="book-detail-section" aria-labelledby="insights-title">
              <h2 id="insights-title">重要な気づき</h2>
              {
                relatedNotes.length > 0 ? (
                  <ul class="insight-list">
                    {relatedNotes.map((note) => (
                      <li>
                        <a href={`/notes/${note.slug}/`}>{note.title}</a>
                      </li>
                    ))}
                  </ul>
                ) : (
                  <EmptyState
                    title="この本に紐づく読書メモはまだありません"
                    description="実装で使った気づきや疑問を追加すると、ここから戻りやすくなります。"
                  />
                )
              }
            </section>

            <section class="book-detail-section" aria-labelledby="related-books-title">
              <h2 id="related-books-title">関連する技術書</h2>
              {
                relatedBooks.length > 0 ? (
                  <div class="related-book-list">
                    {relatedBooks.map((relatedBook) => (
                      <a class="related-book-card" href={`/books/${relatedBook.slug}/`}>
                        <span class="related-book-card__title">{relatedBook.title}</span>
                        <span class="related-book-card__meta">
                          {relatedBook.topics?.[0]?.name ?? '関連トピック未設定'}
                        </span>
                      </a>
                    ))}
                  </div>
                ) : (
                  <EmptyState
                    title="関連する技術書はまだ見つかっていません"
                    description="同じ技術トピックを持つ本が増えると、ここに接続が表示されます。"
                  />
                )
              }
            </section>
          </div>
        </div>
      </article>
    </PageShell>
  </AppShell>
</BaseLayout>

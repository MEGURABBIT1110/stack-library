---
import AppShell from '@/components/layout/AppShell.astro';
import PageShell from '@/components/layout/PageShell.astro';
import TopicChip from '@/components/topic/TopicChip.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTopics } from '@/lib/queries/topics';

const topics = await getTopics();
---

<BaseLayout title="技術トピック" description="本ではなく技術トピックから知識へ戻るページ。">
  <AppShell currentPath={Astro.url.pathname}>
    <PageShell variant="wide">
      <section class="simple-panel">
        <h1 class="simple-panel__title">技術トピック</h1>
        <p class="simple-panel__description">本よりも重要な探索軸として、技術トピックを収蔵します。</p>
      </section>
      <div class="listing-grid">
        {
          topics.map((topic) => (
            <article class="simple-panel">
              <TopicChip topic={topic} size="md" />
              <h2 class="simple-panel__title">{topic.name}</h2>
              <p class="simple-panel__description">{topic.description}</p>
            </article>
          ))
        }
      </div>
    </PageShell>
  </AppShell>
</BaseLayout>

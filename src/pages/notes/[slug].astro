---
import AppShell from '@/components/layout/AppShell.astro';
import PageShell from '@/components/layout/PageShell.astro';
import TopicChip from '@/components/topic/TopicChip.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getNoteBySlug, getNotes } from '@/lib/queries/notes';
import { NOTE_TYPE_LABELS } from '@/types/content';

export async function getStaticPaths() {
  const notes = await getNotes();

  return notes.map((note) => ({
    params: { slug: note.slug },
    props: { note },
  }));
}

const slug = Astro.params.slug;
const note = Astro.props.note ?? (slug ? await getNoteBySlug(slug) : null);

if (!note) {
  return Astro.redirect('/notes/');
}
---

<BaseLayout title={note.title} description={note.body}>
  <AppShell currentPath="/notes/">
    <PageShell variant="reading">
      <article class="simple-panel">
        <p class="minor-heading">{NOTE_TYPE_LABELS[note.noteType]}</p>
        <h1 class="simple-panel__title">{note.title}</h1>
        <p class="simple-panel__description">{note.body}</p>
        {note.implementationHint && <p class="simple-panel__description">実装ヒント: {note.implementationHint}</p>}
        {note.nextAction && <p class="simple-panel__description">次のアクション: {note.nextAction}</p>}
        {note.book && <p class="simple-panel__description">関連書籍: <a class="text-link" href={`/books/${note.book.slug}/`}>{note.book.title}</a></p>}
        {note.topics && <div class="book-card__topics">{note.topics.map((topic) => <TopicChip topic={topic} />)}</div>}
      </article>
    </PageShell>
  </AppShell>
</BaseLayout>

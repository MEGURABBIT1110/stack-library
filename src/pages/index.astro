---
import AppShell from '@/components/layout/AppShell.astro';
import PageShell from '@/components/layout/PageShell.astro';
import SectionHeader from '@/components/layout/SectionHeader.astro';
import BookCard from '@/components/book/BookCard.astro';
import TopicChip from '@/components/topic/TopicChip.astro';
import MetricGrid from '@/components/ui/MetricGrid.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { SITE_DESCRIPTION, SITE_NAME } from '@/lib/constants';
import { getAppliedBooks, getBooks, getReadingBooks, getRereadCandidates } from '@/lib/queries/books';
import { getRecentNotes } from '@/lib/queries/notes';
import { getTopics } from '@/lib/queries/topics';

const [books, readingBooks, topics, recentNotes, rereadCandidates, appliedBooks] = await Promise.all([
  getBooks(),
  getReadingBooks(),
  getTopics(),
  getRecentNotes(5),
  getRereadCandidates(),
  getAppliedBooks(),
]);

const metrics = [
  { label: '読了数', value: books.filter((book) => book.status === 'read').length },
  { label: '読書中', value: readingBooks.length },
  { label: '再読候補', value: rereadCandidates.length },
  { label: '実装接続', value: appliedBooks.length },
  { label: '読書メモ', value: recentNotes.length },
];
---

<BaseLayout title={SITE_NAME} description={SITE_DESCRIPTION}>
  <AppShell currentPath={Astro.url.pathname}>
    <PageShell variant="wide">
      <section class="hero" aria-labelledby="page-title">
        <div>
          <h1 id="page-title" class="hero__title">Stack Library</h1>
          <p class="hero__copy">技術書を、知識・実装・再読のために再配置する。</p>
        </div>
        <div class="hero__pattern" aria-hidden="true"></div>
      </section>

      <div class="section-stack">
        <section aria-labelledby="reading-books-title">
          <SectionHeader title="01. 読書中の技術書" href="/library/" />
          <div class="cards-row">
            {readingBooks.slice(0, 3).map((book) => <BookCard book={book} variant="specimen" showProgress />)}
          </div>
        </section>

        <section class="overview-lower-grid" aria-label="技術トピックと読書シグナル">
          <div class="topic-cluster">
            <h2 class="minor-heading">Active Topics</h2>
            <div class="topic-cluster__chips">
              {topics.slice(0, 6).map((topic) => <TopicChip topic={topic} />)}
            </div>
          </div>
          <MetricGrid items={metrics} />
        </section>
      </div>
    </PageShell>
  </AppShell>
</BaseLayout>

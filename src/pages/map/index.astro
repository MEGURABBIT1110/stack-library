---
import AppShell from '@/components/layout/AppShell.astro';
import PageShell from '@/components/layout/PageShell.astro';
import EmptyState from '@/components/ui/EmptyState.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="知識マップ" description="技術書、トピック、メモ、学習ルートをつなぐ知識マップ。">
  <AppShell currentPath={Astro.url.pathname}>
    <PageShell variant="wide">
      <section class="simple-panel">
        <h1 class="simple-panel__title">知識マップ</h1>
        <p class="simple-panel__description">本、技術トピック、読書メモ、学習ルートをノードとして接続します。</p>
      </section>
      <EmptyState
        title="知識マップは初期実装待ちです。"
        description="まずは各ノードの一覧と詳細導線を整えたあと、ここで関係性を観測できるようにします。"
      />
    </PageShell>
  </AppShell>
</BaseLayout>

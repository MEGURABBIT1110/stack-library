---
type MetricItem = {
  label: string;
  value: string | number;
};

type Props = {
  title?: string;
  items: MetricItem[];
};

const { title = 'Signals', items } = Astro.props;
---

<section class="metric-section" aria-labelledby="metric-grid-title">
  <h2 id="metric-grid-title" class="metric-section__title">{title}</h2>
  <div class="metric-grid">
    {
      items.map((item) => (
        <div class="metric-grid__item">
          <p class="metric-grid__value">{item.value}</p>
          <p class="metric-grid__label">{item.label}</p>
        </div>
      ))
    }
  </div>
</section>

---
type Props = {
  title: string;
  description?: string;
  actionHref?: string;
  actionLabel?: string;
};

const { title, description, actionHref, actionLabel } = Astro.props;
---

<div class="empty-state">
  <p class="empty-state__title">{title}</p>
  {description && <p class="empty-state__description">{description}</p>}
  {actionHref && actionLabel && <a class="text-link" href={actionHref}>{actionLabel}</a>}
</div>

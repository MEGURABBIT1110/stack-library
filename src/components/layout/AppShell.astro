---
import SiteSidebar from './SiteSidebar.astro';
import TopBar from './TopBar.astro';

type Props = {
  currentPath?: string;
  showTopBar?: boolean;
};

const { currentPath = '/', showTopBar = true } = Astro.props;
---

<div class="app-shell">
  <SiteSidebar currentPath={currentPath} />
  <div class:list={['app-main', !showTopBar && 'app-main--plain']}>
    {showTopBar && <TopBar />}
    <main id="main-content" class:list={['app-main__content', !showTopBar && 'app-main__content--full-height']}>
      <slot />
    </main>
  </div>
</div>

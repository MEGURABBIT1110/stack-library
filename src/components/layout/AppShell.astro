---
import SiteSidebar from './SiteSidebar.astro';
import TopBar from './TopBar.astro';

type Props = {
  currentPath?: string;
};

const { currentPath = '/' } = Astro.props;
---

<div class="app-shell">
  <SiteSidebar currentPath={currentPath} />
  <div class="app-main">
    <TopBar />
    <main id="main-content" class="app-main__content">
      <slot />
    </main>
  </div>
</div>

---
import type { SignalValue } from '@/types/content';
import SignalMeter from '@/components/ui/SignalMeter.astro';

type Props = {
  difficulty?: SignalValue;
  practicality?: SignalValue;
  rereadValue?: SignalValue;
  conceptDensity?: SignalValue;
  implementationValue?: SignalValue;
};

const {
  difficulty,
  practicality,
  rereadValue,
  conceptDensity,
  implementationValue,
} = Astro.props;

const standardLabels: Record<SignalValue, string> = {
  1: '低',
  2: 'やや低',
  3: '中',
  4: '高',
  5: '非常に高',
};

const difficultyLabels: Record<SignalValue, string> = {
  1: '入門',
  2: '初級',
  3: '中級',
  4: '上級',
  5: '高難度',
};

const signals = [
  {
    label: '難易度',
    value: difficulty,
    valueLabel: difficulty ? difficultyLabels[difficulty] : undefined,
  },
  {
    label: '実務適用度',
    value: practicality,
    valueLabel: practicality ? standardLabels[practicality] : undefined,
  },
  {
    label: '再読価値',
    value: rereadValue,
    valueLabel: rereadValue ? standardLabels[rereadValue] : undefined,
  },
  {
    label: '概念密度',
    value: conceptDensity,
    valueLabel: conceptDensity ? standardLabels[conceptDensity] : undefined,
  },
  {
    label: '実装接続度',
    value: implementationValue,
    valueLabel: implementationValue ? standardLabels[implementationValue] : undefined,
  },
];
---

<section class="book-signal-panel" aria-labelledby="book-signals-title">
  <h2 id="book-signals-title" class="book-signal-panel__title">ANALYTICAL SIGNALS</h2>
  <div class="book-signal-panel__list">
    {
      signals.map((signal) => (
        <SignalMeter
          label={signal.label}
          value={signal.value}
          valueLabel={signal.valueLabel}
        />
      ))
    }
  </div>
</section>

---
import { READING_STATUS_LABELS, type ReadingStatus } from '@/types/content';

type Props = {
  status: ReadingStatus;
  size?: 'sm' | 'md';
  label?: string;
};

const { status, size = 'sm', label = READING_STATUS_LABELS[status] } = Astro.props;
---

<span class:list={['badge', `badge--${size}`, `badge--status-${status}`]} aria-label={`読書状態: ${label}`}>
  {label}
</span>

---
import { clampProgress, formatAuthors } from '@/lib/format';
import type { Book, SignalValue } from '@/types/content';
import ReadingStatusBadge from './ReadingStatusBadge.astro';
import TopicChip from '@/components/topic/TopicChip.astro';

type Props = {
  book: Book;
  variant?: 'default' | 'compact' | 'featured' | 'specimen';
  showProgress?: boolean;
  showTopics?: boolean;
};

const {
  book,
  variant = 'default',
  showProgress = false,
  showTopics = false,
} = Astro.props;

const progress = clampProgress(book.readingProgress);
const coverAlt = `「${book.title}」の表紙`;
const isSpecimen = variant === 'specimen';
const specimenTopics = book.topics?.filter((topic) => topic.slug !== 'ux-engineering') ?? [];
const topicCandidates = isSpecimen
  ? (specimenTopics.length > 0 ? specimenTopics : book.topics ?? [])
  : (book.topics ?? []);
const visibleTopics = topicCandidates.slice(0, isSpecimen ? 2 : 3);
const specimenTopicLabels: Record<string, string> = {
  accessibility: 'Accessibility',
  'css-architecture': 'CSS設計',
  'design-system': 'Design System',
  'ux-engineering': 'UX Engineering',
  react: 'React',
  typescript: 'TypeScript',
  nextjs: 'Next.js',
};
const specimenStatusLabels: Partial<Record<Book['status'], string>> = {
  unread: '積読',
};

const signals: Array<{ label: string; name: string; value?: SignalValue }> = [
  { label: 'Lv.', name: '難易度', value: book.difficulty },
  { label: 'Imp.', name: '実装接続度', value: book.implementationValue },
  { label: 'Ret.', name: '再読価値', value: book.rereadValue },
];
---

<article class:list={['book-card', `book-card--${variant}`]}>
  <div class="book-card__cover">
    {
      book.cover ? (
        <img src={book.cover.url} alt={coverAlt} loading="lazy" />
      ) : (
        <span class="book-card__cover-label" aria-hidden="true">{book.title.slice(0, 2)}</span>
      )
    }
  </div>

  <div class="book-card__body">
    <h3 class="book-card__title">
      <a href={`/books/${book.slug}/`}>{book.title}</a>
    </h3>
    {book.subtitle && !isSpecimen && <p class="book-card__subtitle">{book.subtitle}</p>}
    <p class="book-card__authors">{formatAuthors(book.authors)}</p>
  </div>

  {
    isSpecimen ? (
      <div class="book-card__chips" aria-label="読書状態と関連技術トピック">
        <ReadingStatusBadge status={book.status} label={specimenStatusLabels[book.status]} />
        {visibleTopics.map((topic) => <TopicChip topic={topic} label={specimenTopicLabels[topic.slug] ?? topic.name} />)}
      </div>
    ) : (
      showTopics && visibleTopics.length > 0 && (
        <div class="book-card__topics" aria-label="関連技術トピック">
          {visibleTopics.map((topic) => <TopicChip topic={topic} />)}
        </div>
      )
    )
  }

  <div class="book-card__footer">
    {
      isSpecimen ? (
        <div class="book-card__signals" aria-label="読書シグナル">
          {
            signals.map((signal) => {
              const value = signal.value ?? 0;

              return (
                <div class="mini-signal" aria-label={`${signal.name} ${value > 0 ? `${value}/5` : '未設定'}`}>
                  <span class="mini-signal__label" aria-hidden="true">{signal.label}</span>
                  <span class="mini-signal__ticks" aria-hidden="true">
                    {[1, 2, 3, 4, 5].map((step) => (
                      <span class:list={['mini-signal__tick', step <= value && 'is-active']} />
                    ))}
                  </span>
                </div>
              );
            })
          }
        </div>
      ) : showProgress ? (
        <>
          <div class="progress-meter" aria-label={`読書進捗 ${progress}%`}>
            <span class="progress-meter__track" aria-hidden="true">
              <span class="progress-meter__fill" style={`width: ${progress}%`} />
            </span>
          </div>
          <div class="book-card__status-row">
            <ReadingStatusBadge status={book.status} />
            <span>{progress}%</span>
          </div>
        </>
      ) : (
        <div class="book-card__status-row">
          <ReadingStatusBadge status={book.status} />
          {book.implementationValue && <span>実装接続度 {book.implementationValue}/5</span>}
        </div>
      )
    }
  </div>
</article>

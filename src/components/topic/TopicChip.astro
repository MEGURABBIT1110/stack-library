---
import type { Topic } from '@/types/content';

type Props = {
  topic: Topic;
  href?: string;
  size?: 'sm' | 'md';
  label?: string;
};

const { topic, href = `/topics/${topic.slug}/`, size = 'sm', label = topic.name } = Astro.props;
---

<a class:list={['topic-chip', `topic-chip--${size}`]} href={href}>
  {label}
</a>

    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/browser-playwright": "^4.1.10",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.62.1",
    "storybook": "^10.5.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "packageManager": "npm@12.0.2",
  "engines": {
